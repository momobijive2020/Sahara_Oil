# SAHARA OIL TRADING — variables d'environnement
# Copiez ce fichier en .env (jamais commité) ou saisissez ces clés dans Render > Environment.

SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
FLASK_DEBUG=0
ADMIN_TOKEN=un-autre-secret-pour-admin-messages

# --- Messagerie IONOS (déjà pré-configurée dans app.py) ---
# Seule cette ligne est obligatoire : le mot de passe de la boîte IONOS.
SMTP_PASSWORD=mot-de-passe-de-la-boite-mail

# Valeurs par défaut, à ne changer qu'en cas de besoin :
# SMTP_HOST=smtp.ionos.fr
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=saharaoil.trading@saharaoiltrading.org
# MAIL_FROM=saharaoil.trading@saharaoiltrading.org
# MAIL_TO=saharaoil.trading@saharaoiltrading.org
